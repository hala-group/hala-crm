FROM node:24-bookworm-slim AS workspace
WORKDIR /app
RUN npm install --global pnpm@11.25.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
ENV MONGOMS_DISABLE_POSTINSTALL=1
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @hala/shared build
RUN pnpm --filter @hala/web build

FROM nginx:1.29-alpine AS web
ENV UPSTREAM_API=http://api:3000
ENV PORT=80
ENV NGINX_ENVSUBST_FILTER="UPSTREAM_API PORT"
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=workspace /app/apps/web/dist/browser /usr/share/nginx/html
EXPOSE 80
